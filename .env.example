NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Admin auth. Prefer ADMIN_PASSWORD_HASH. ADMIN_PASSWORD is local-development only.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# MongoDB content storage.
MONGODB_URI=
MONGODB_DB=baseknowledge

# Cloudinary uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenAI multimodal assistant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
